{
  "name": "@sasaki-s-sci/dooc-plugins",
  "version": "0.0.2",
  "description": "URL-based Linear, GitHub and Slack viewers for dooc.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./viewer": "./dist/src/viewer.js",
    "./linear": {
      "types": "./dist/src/linear.d.ts",
      "default": "./dist/src/linear.js"
    },
    "./github": {
      "types": "./dist/src/github.d.ts",
      "default": "./dist/src/github.js"
    },
    "./slack": {
      "types": "./dist/src/slack.d.ts",
      "default": "./dist/src/slack.js"
    }
  },
  "files": [
    "dist/src",
    "assets",
    "docs",
    "examples",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/dev/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@sasaki-s-sci/dooc-plugin": "0.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sasaki-s-sci/dooc": "0.0.22",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasaki-s-sci/dooc-plugins.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
